# Set default behavior to automatically normalize line endings
* text=auto

# Unity text files should always use LF in the repo
*.cs      text eol=lf
*.shader  text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.asmdef  text eol=lf

# Unity scene and prefab files are text (YAML) and should use LF
*.unity   text eol=lf
*.prefab  text eol=lf
*.mat     text eol=lf
*.meta    text eol=lf

# Ignore binaries (no line ending conversion)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.tga     binary
*.fbx     binary
*.mp3     binary
*.wav     binary
*.ogg     binary
*.mp4     binary
*.aiff    binary
*.dll     binary
*.exe     binary

# Optional: lock file for package manager
Packages/manifest.json text eol=lf
Packages/packages-lock.json text eol=lf
